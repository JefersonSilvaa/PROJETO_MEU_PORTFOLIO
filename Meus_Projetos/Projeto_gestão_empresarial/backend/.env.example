# =========================================================
# Projeto Gestao Empresarial - Backend
# Template de variaveis de ambiente (NAO usar valores reais)
# Copie para .env e preencha com os segredos do seu ambiente.
# =========================================================

# Ambiente da aplicacao: development | production
NODE_ENV=development

# Servidor
PORT=3001

# CORS (aceita lista separada por virgula)
# Exemplo dev: http://localhost:5173
# Exemplo prod: https://meudominio.com,https://www.meudominio.com
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------
# Defina o dialeto explicitamente para evitar ambiguidades.
# Valores aceitos: sqlite | mysql
DB_DIALECT=sqlite

# SQLite (desenvolvimento local)
DB_STORAGE=./database.sqlite

# MySQL (producao ou ambiente com servidor SQL)
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# ---------------------------------------------------------
# Autenticacao JWT
# ---------------------------------------------------------
# Gere um segredo forte (minimo recomendado: 32+ caracteres aleatorios)
# Exemplo (nao reutilize): openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=8h

# ---------------------------------------------------------
# Seed de usuario administrador
# ---------------------------------------------------------
# Em producao, mantenha como false apos bootstrap inicial.
SEED_ADMIN=false
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------------------------------------------------------
# SMTP (opcional) - notificacoes por e-mail
# ---------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---------------------------------------------------------
# PERFIS SUGERIDOS
# ---------------------------------------------------------
# DEV (local com sqlite)
# NODE_ENV=development
# DB_DIALECT=sqlite
# DB_STORAGE=./database.sqlite
# FRONTEND_URL=http://localhost:5173
# SEED_ADMIN=true
# ADMIN_EMAIL=dev-admin@example.com
# ADMIN_PASSWORD=<SENHA_FORTE_12+>

# PROD (mysql)
# NODE_ENV=production
# DB_DIALECT=mysql
# DB_HOST=<host>
# DB_PORT=3306
# DB_NAME=<database>
# DB_USER=<user>
# DB_PASSWORD=<password>
# FRONTEND_URL=https://seu-frontend.com
# JWT_SECRET=<SEGREDO_FORTE_32+>
# SEED_ADMIN=false
